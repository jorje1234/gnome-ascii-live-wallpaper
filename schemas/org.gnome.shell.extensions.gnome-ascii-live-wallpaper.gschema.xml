<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.gnome-ascii-live-wallpaper"
          path="/org/gnome/shell/extensions/gnome-ascii-live-wallpaper/">
    <key name="enabled" type="b">
      <default>true</default>
      <summary>Enable animated ASCII wallpaper</summary>
      <description>Master toggle to activate or deactivate the live wallpaper without disabling the extension.</description>
    </key>
    <key name="piece" type="s">
      <default>'spiral-galaxy'</default>
      <summary>Active piece slug</summary>
    </key>
    <key name="look" type="s">
      <default>'dots'</default>
      <summary>Visual render look</summary>
    </key>
    <key name="custom-chars" type="s">
      <default>''</default>
      <summary>Optional custom character ramp (overrides look glyphs when non-empty)</summary>
    </key>
    <key name="fps" type="i">
      <range min="5" max="60"/>
      <default>30</default>
      <summary>Target animation frames per second</summary>
    </key>
    <key name="render-scale" type="d">
      <range min="0.35" max="1.0"/>
      <default>0.65</default>
      <summary>Internal Cairo render resolution multiplier</summary>
    </key>
    <key name="speed" type="d">
      <range min="0.1" max="3.0"/>
      <default>1.0</default>
      <summary>Animation playback speed multiplier</summary>
    </key>
    <key name="fit" type="s">
      <default>'cover'</default>
      <summary>Screen fit mode (cover or contain)</summary>
    </key>
    <key name="bg" type="s">
      <default>'#040406'</default>
      <summary>Background hex color</summary>
    </key>
    <key name="ink" type="s">
      <default>'#e4e4e7'</default>
      <summary>Default ink hex color</summary>
    </key>
    <key name="dot-size" type="d">
      <range min="0.15" max="1.5"/>
      <default>0.51</default>
      <summary>Halftone dot size multiplier</summary>
    </key>
    <key name="density" type="d">
      <range min="0.4" max="2.2"/>
      <default>1.31</default>
      <summary>Halftone grid sampling density</summary>
    </key>
    <key name="contrast" type="i">
      <range min="-50" max="50"/>
      <default>0</default>
      <summary>Halftone tone contrast adjustment</summary>
    </key>
    <key name="mono" type="b">
      <default>false</default>
      <summary>Monochrome rendering</summary>
    </key>
    <key name="all-glyphs" type="b">
      <default>false</default>
      <summary>Convert all glyphs into halftone dots/squares</summary>
    </key>
    <key name="pause-when-maximized" type="b">
      <default>true</default>
      <summary>Auto-pause when windows cover the desktop or screen is locked</summary>
    </key>
    <key name="pause-on-power-saver" type="b">
      <default>true</default>
      <summary>Auto-pause when GNOME Power Saver mode is active</summary>
    </key>
    <key name="toggle-shortcut" type="as">
      <default>['&lt;Super&gt;&lt;Alt&gt;a']</default>
      <summary>Keyboard shortcut to toggle the live wallpaper ON/OFF</summary>
    </key>
    <key name="piece-params" type="s">
      <default>'{}'</default>
      <summary>JSON map of per-piece custom parameters</summary>
    </key>
  </schema>
</schemalist>
